# Copy this file to .env in this folder (hw4/.env) and fill in your key.
# Placeholders only: never commit or submit the real .env (it is in .gitignore).

# --- Model access: OpenAI models through the Portkey gateway ---------------
PORTKEY_API_KEY=replace_with_your_portkey_api_key
PORTKEY_BASE_URL=https://api.portkey.ai/v1
PORTKEY_PROVIDER=openai

# --- Model selection --------------------------------------------------------
# Dan, the concierge who talks to shoppers. gpt-5.6-terra answers in ~3-5 s;
# gpt-5.6-sol is stronger and slower.
CAMPUS_CUSTOMS_MODEL=gpt-5.6-terra
# The Scout, the Stylist and the memory clerk: narrower jobs on the cheaper tier.
CAMPUS_CUSTOMS_TEAM_MODEL=gpt-5.6-luna

# --- Cookies ----------------------------------------------------------------
# Set to true when the site is served over HTTPS.
COOKIE_SECURE=false
